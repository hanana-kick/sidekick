+import {defineSidekick,SidekickAvatar} from '../../src/element/avatar.js';
+import {AtomicSurfaceAvatar} from './element.js';
+defineSidekick();customElements.define('sidekick-atomic-experiment',AtomicSurfaceAvatar);
+const nodes=[...document.querySelectorAll<SidekickAvatar>('sidekick-avatar,sidekick-atomic-experiment')];
+const output=document.querySelector<HTMLElement>('#output')!,diagnostics=document.querySelector<HTMLElement>('#diagnostics')!;
+const ready=(bot:SidekickAvatar)=>bot.ready?Promise.resolve():new Promise<void>((resolve,reject)=>{bot.addEventListener('sidekick-ready',()=>resolve(),{once:true});setTimeout(()=>reject(new Error('Ready timeout')),12000);});
+function report(){diagnostics.textContent=nodes.map((bot,i)=>`${['Baseline','Atomic worker','Atomic main'][i]}: ${bot.diagnostics.backend}/${bot.diagnostics.graphics} · ${JSON.stringify((bot as AtomicSurfaceAvatar).atomicMetrics??{})}`).join('\n');}
+function check(condition:boolean,name:string,lines:string[]){lines.push(`${condition?'PASS':'FAIL'} ${name}`);}
+async function checks(){
+ const lines:string[]=[];output.textContent='Running visible checks…';
+ try{
+  await Promise.all(nodes.map(ready));nodes.forEach(bot=>{bot.mouseTracking=false;bot.resetTracking();bot.resetBodyOrientation();bot.lookAt({space:'view',x:0,y:0});bot.paused=true;bot.setActivity('still');bot.seek(0);});
+  const images=await Promise.all(nodes.map(bot=>bot.capturePixelsAsync()));
+  for(let i=1;i<images.length;i++){const image=images[i]!,base=images[0]!;check(image.width===base.width&&image.height===base.height,`mode${i} full capture dimensions`,lines);let mismatch=0;for(let j=0;j<image.pixels.length;j++)if(image.pixels[j]!==base.pixels[j])mismatch++;check(mismatch===0,`mode${i} exact fresh Canvas pixels (${mismatch} differing channels)`,lines);}
+  for(let i=1;i<nodes.length;i++){const bot=nodes[i]!;const sync=bot.capturePixels();check(sync.width===images[i]!.width&&sync.height===images[i]!.height,`mode${i} synchronous capture dimensions`,lines);check((await bot.snapshot()).size>0,`mode${i} PNG export`,lines);}
+  await new Promise(resolve=>setTimeout(resolve,150));const before=nodes.slice(1).map(bot=>(bot as AtomicSurfaceAvatar).atomicMetrics?.created);
+  await new Promise(resolve=>setTimeout(resolve,250));
+  nodes.slice(1).forEach((bot,i)=>{const m=(bot as AtomicSurfaceAvatar).atomicMetrics;check(m?.created===before[i],`mode${i+1} paused transfer loop stopped`,lines);check(m?.maxInFlight===1&&m.maxPending===1,`mode${i+1} bounded bitmap ownership`,lines);});
+  const beforePosition=nodes[1]!.position;await nodes[1]!.moveTo({x:12,y:8},{duration:0,travel:'none'});check(nodes[1]!.position.x===12&&nodes[1]!.position.y===8,'legacy XY movement',lines);await nodes[1]!.moveTo(beforePosition,{duration:0,travel:'none'});
+  const candidate=nodes[1]!,parent=candidate.parentElement!;candidate.remove();parent.append(candidate);await ready(candidate);check(candidate.ready,'disconnect/reconnect recovery',lines);
+ }catch(error){lines.push(`FAIL ${error instanceof Error?error.message:String(error)}`);}
+ const pass=lines.filter(line=>line.startsWith('PASS')).length,fail=lines.filter(line=>line.startsWith('FAIL')).length;
+ output.textContent=`${pass} PASS / ${fail} FAIL\n${lines.join('\n')}`;report();
+}
+document.querySelector('#checks')!.addEventListener('click',()=>void checks());
+document.querySelector('#animate')!.addEventListener('click',()=>{nodes.forEach(bot=>{bot.paused=false;bot.setActivity('idle');});output.textContent='Animating all three through their normal runtime cadence.';setTimeout(report,500);});
+document.querySelector('#pause')!.addEventListener('click',()=>{nodes.forEach(bot=>{bot.paused=true;bot.seek(0);});output.textContent='Paused. No repeat bitmap transfers should remain.';setTimeout(report,500);});
+document.querySelector('#size')!.addEventListener('change',event=>{const size=Number((event.target as HTMLSelectElement).value);nodes.forEach(bot=>bot.size=size);output.textContent=`Requested ${size}px. Existing DPR and backing caps are unchanged.`;setTimeout(report,500);});
+let activations=0;nodes.forEach(bot=>bot.addEventListener('sidekick-activate',()=>{document.querySelector('#activations')!.textContent=`Visible bot activations: ${++activations}`;}));
+Promise.all(nodes.map(ready)).then(()=>{output.textContent='Ready. Run visible checks.';report();}).catch(error=>{output.textContent=String(error);report();});
