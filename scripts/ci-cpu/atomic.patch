+import { SidekickAvatar } from '../../src/element/avatar.js';
+import type { BridgeCallbacks,RenderBridge } from '../../src/runtime/render-bridge.js';
+import { AtomicSurfaceBridge } from './bridge.js';
+/** Isolated opt-in test element, never registered by the package. */
+export class AtomicSurfaceAvatar extends SidekickAvatar {
+ private fullHostSurface?: HTMLDivElement;
+ private observedCanvas?: HTMLCanvasElement;
+ private surfaceObserver?: MutationObserver;
+ private ensureFullHostSurface(canvas:HTMLCanvasElement):HTMLDivElement {
+  let surface=this.fullHostSurface;
+  if(!surface){
+   surface=this.ownerDocument.createElement('div');surface.dataset.atomicFullHost='';surface.setAttribute('aria-hidden','true');
+   Object.assign(surface.style,{position:'absolute',inset:'0',pointerEvents:'var(--sidekick-pointer-events,none)',touchAction:'var(--sidekick-touch-action,auto)'});
+   canvas.before(surface);this.fullHostSurface=surface;
+  }
+  if(canvas.parentElement!==surface)surface.append(canvas);
+  if(this.observedCanvas!==canvas||!this.surfaceObserver){
+   this.surfaceObserver?.disconnect();this.observedCanvas=canvas;
+   const sync=()=>{surface!.hidden=canvas.hidden||!this.isConnected;};sync();
+   this.surfaceObserver=new MutationObserver(sync);this.surfaceObserver.observe(canvas,{attributes:true,attributeFilter:['hidden']});
+  }
+  return surface;
+ }
+ protected override interactionSurface(canvas:HTMLCanvasElement):HTMLElement{return this.ensureFullHostSurface(canvas);}
+ protected override entranceSurface(canvas:HTMLCanvasElement):HTMLElement{return this.ensureFullHostSurface(canvas);}
+ override disconnectedCallback():void{
+  super.disconnectedCallback();this.surfaceObserver?.disconnect();this.surfaceObserver=undefined;this.observedCanvas=undefined;
+  if(this.fullHostSurface)this.fullHostSurface.hidden=true;
+ }
+ private atomicBridge?:AtomicSurfaceBridge;
+ get atomicMetrics(){return this.atomicBridge?.presentationStats;}
+ simulateWorkerFailureForTest():void{if(!this.atomicBridge)throw new Error('Atomic bridge is not ready.');this.atomicBridge.simulateWorkerFailureForTest();}
+ override capturePixels(){
+  if(this.atomicBridge?.backend==='worker'){if(!this.ready)throw new Error('Avatar is not ready.');return this.atomicBridge.capture();}
+  return super.capturePixels();
+ }
+ protected override createRenderBridge(canvas:HTMLCanvasElement,generation:number,callbacks:BridgeCallbacks,worker:boolean):RenderBridge{
+  return this.atomicBridge=new AtomicSurfaceBridge(canvas,generation,callbacks,worker&&!this.hasAttribute('force-main'));
+ }
+}
+
