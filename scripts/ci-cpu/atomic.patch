+    if (this.canvas.height !== this.surface.height) this.canvas.height = this.surface.height;
+    this.underlying.setViewport?.({ x: this.surface.x, y: this.fullHeight - this.surface.y - this.surface.height, width: this.fullWidth, height: this.fullHeight });
