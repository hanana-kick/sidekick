+import { clamp } from '../core/math.js';
+import type { Mat4 } from '../core/math.js';
+import type { AvatarDesign } from '../core/design.js';
+import type { Geometry } from './geometry.js';
+import type { Mesh, RenderBackend, RendererOptions } from './render-backend.js';
+import type { SoftwareEyes } from './software-rasterizer.js';
+import { AvatarRenderer } from './webgl.js';
+import type { RenderState } from './webgl.js';
+import { growSurface, projectedVertexBounds } from './render-surface.js';
+import type { Bounds2, RenderSurface } from './render-surface.js';
+
+/** Experimental direct-module entry only; never imported by production entrypoints.
+ * Callers must place the cropped canvas using surface metadata. No element/worker integration.
+ */
+export class TightSurfaceRenderer extends AvatarRenderer {
+  private tight?: TightSurfaceBackend;
+  constructor(canvas: HTMLCanvasElement | OffscreenCanvas, options: RendererOptions = {}) {
+    super(canvas, options);
+    {
+      this.tight = new TightSurfaceBackend(canvas, this.backend);
+      this.backend = this.tight;
+      this.displayAspect = canvas.width / canvas.height;
+    }
+  }
+  get surface(): RenderSurface | undefined {
+    return this.tight ? this.tight.surface : { x: 0, y: 0, width: this.canvas.width, height: this.canvas.height, fullWidth: this.canvas.width, fullHeight: this.canvas.height };
+  }
+  override resize(width: number, height: number, dpr = 1): void {
+    if (!this.tight) { super.resize(width, height, dpr); return; }
+    const cssWidth = Math.max(1, width), cssHeight = Math.max(1, height);
+    const scale = Math.min(clamp(dpr, 1, 2), this.tight.maxDimension / Math.max(cssWidth, cssHeight));
+    this.displayAspect = cssWidth / cssHeight;
+    this.tight.resize(Math.max(1, Math.round(cssWidth * scale)), Math.max(1, Math.round(cssHeight * scale)));
+  }
+  override render(input: AvatarDesign, state: RenderState): void {
+    try { super.render(input, state); }
+    catch (error) {
+      // Only deferred WebGL has CPU caches ahead of unsubmitted draw/update commands.
+      this.tight?.finishFailedFrame();
+      throw error;
+    }
+  }
+}
+
+/** Borrowed geometry, matrices and eye values must stay immutable through end().
+ * Current AvatarRenderer call sites obey this. Do not pool inputs between draws
+ * without frame snapshots: recorded bounds and commands must describe the same data.
+ */
+class TightSurfaceBackend implements RenderBackend {
+  get kind(): 'webgl2' | 'canvas2d' { return this.underlying.kind; }
+  private commands?: (() => void)[];
+  private bounds: Bounds2 = [Infinity, Infinity, -Infinity, -Infinity];
+  private projection?: Mat4;
+  private drawIndices = new WeakMap<Uint16Array, Map<string, Uint16Array>>();
+  private fullWidth: number;
+  private fullHeight: number;
+  surface?: RenderSurface;
+  constructor(private canvas: HTMLCanvasElement | OffscreenCanvas, private underlying: RenderBackend) {
+    this.fullWidth = canvas.width; this.fullHeight = canvas.height;
+  }
+  get gl(): WebGL2RenderingContext | undefined { return this.underlying.gl; }
+  get maxDimension(): number { return this.underlying.maxDimension; }
+  get lost(): boolean { return this.underlying.lost; }
+  resize(width: number, height: number): void {
+    if (width !== this.fullWidth || height !== this.fullHeight) this.surface = undefined;
+    this.fullWidth = width; this.fullHeight = height;
+    // Allocate only the final crop in end(), not a temporary full-size surface.
+  }
+  upload(data: Geometry): Mesh { return this.underlying.upload(data); }
+  update(mesh: Mesh, data: Geometry, indices: boolean, reuseVertices: boolean): void {
+    if (indices) this.drawIndices.delete(data.indices);
+    const update = (): void => this.underlying.update(mesh, data, indices, reuseVertices);
+    if (this.commands) this.commands.push(update); else update();
+  }
+  deleteMesh(mesh: Mesh): void { this.underlying.deleteMesh(mesh); }
+  begin(projection: Mat4): void {
+    this.projection = projection; this.commands = [];
+    this.bounds = [Infinity, Infinity, -Infinity, -Infinity];
+  }
+  eyes(eyes?: SoftwareEyes): void { this.commands!.push(() => this.underlying.eyes(eyes)); }
+  opacity(value: number): void { this.commands!.push(() => this.underlying.opacity(value)); }
+  draw(mesh: Mesh, model: Mat4, color: string, count: number, indexOffset: number): void {
+    // Topology is stable between geometry updates. Deduplicate once, rather than
+    // allocate a Set or project the same shared vertex for every triangle/frame.
+    let ranges = this.drawIndices.get(mesh.data.indices);
+    if (!ranges) { ranges = new Map(); this.drawIndices.set(mesh.data.indices, ranges); }
+    const key = `${indexOffset}:${count}`;
+    let indices = ranges.get(key);
+    if (!indices) { indices = Uint16Array.from(new Set(mesh.data.indices.subarray(indexOffset, indexOffset + count))); ranges.set(key, indices); }
