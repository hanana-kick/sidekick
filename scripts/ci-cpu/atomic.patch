+import type { Mat4 } from '../core/math.js';
+
+/** Integer backing-pixel crop; y is measured from the bottom, as in WebGL. */
+export interface RenderSurface { x: number; y: number; width: number; height: number; fullWidth: number; fullHeight: number }
+export type Bounds3 = readonly [number, number, number, number, number, number];
+export type Bounds2 = [number, number, number, number];
+export function vertexBounds(vertices: Float32Array): Bounds3 {
+  const bounds = [Infinity, Infinity, Infinity, -Infinity, -Infinity, -Infinity];
+  for (let i = 0; i < vertices.length; i += 6) for (let axis = 0; axis < 3; axis++) {
+    bounds[axis] = Math.min(bounds[axis]!, vertices[i + axis]!);
+    bounds[axis + 3] = Math.max(bounds[axis + 3]!, vertices[i + axis]!);
+  }
+  return bounds as unknown as Bounds3;
+}
+/** Conservative affine bounds. Never changes shader projection or model matrices. */
+export function projectedBounds(bounds: Bounds3, model: Mat4, projection: Mat4, width: number, height: number): Bounds2 {
+  const result: Bounds2 = [Infinity, Infinity, -Infinity, -Infinity];
+  for (let corner = 0; corner < 8; corner++) {
+    const x = bounds[corner & 1 ? 3 : 0], y = bounds[corner & 2 ? 4 : 1], z = bounds[corner & 4 ? 5 : 2];
+    const wx = model[0]! * x + model[4]! * y + model[8]! * z + model[12]!;
+    const wy = model[1]! * x + model[5]! * y + model[9]! * z + model[13]!;
+    const wz = model[2]! * x + model[6]! * y + model[10]! * z + model[14]!;
+    const ww = model[3]! * x + model[7]! * y + model[11]! * z + model[15]!;
+    const cx = projection[0]! * wx + projection[4]! * wy + projection[8]! * wz + projection[12]! * ww;
+    const cy = projection[1]! * wx + projection[5]! * wy + projection[9]! * wz + projection[13]! * ww;
+    const cw = projection[3]! * wx + projection[7]! * wy + projection[11]! * wz + projection[15]! * ww;
+    // Unknown/projective matrices do not justify cropping. Current renderer is affine.
+    if (cw !== 1 || !Number.isFinite(cx) || !Number.isFinite(cy)) return [0, 0, width, height];
