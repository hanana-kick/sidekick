+ */
+export function projectedVertexBounds(vertices: Float32Array, indices: Uint16Array, indexOffset: number, count: number, model: Mat4, projection: Mat4, width: number, height: number): Bounds2 {
+  const result: Bounds2 = [Infinity, Infinity, -Infinity, -Infinity];
+  for (let i = indexOffset; i < indexOffset + count; i++) {
+    const index = indices[i]!;
+    const offset = index * 6, x = vertices[offset]!, y = vertices[offset + 1]!, z = vertices[offset + 2]!;
+    const wx = model[0]! * x + model[4]! * y + model[8]! * z + model[12]!;
+    const wy = model[1]! * x + model[5]! * y + model[9]! * z + model[13]!;
+    const wz = model[2]! * x + model[6]! * y + model[10]! * z + model[14]!;
+    const ww = model[3]! * x + model[7]! * y + model[11]! * z + model[15]!;
+    const cx = projection[0]! * wx + projection[4]! * wy + projection[8]! * wz + projection[12]! * ww;
+    const cy = projection[1]! * wx + projection[5]! * wy + projection[9]! * wz + projection[13]! * ww;
+    const cz = projection[2]! * wx + projection[6]! * wy + projection[10]! * wz + projection[14]! * ww;
+    const cw = projection[3]! * wx + projection[7]! * wy + projection[11]! * wz + projection[15]! * ww;
+    if ((!Number.isFinite(cx) || !Number.isFinite(cy) || !Number.isFinite(cz) || !Number.isFinite(cw)) || cw <= 0 || cz < -cw) return [0,0,width,height];
+    const px = (cx / cw + 1) * width / 2, py = (cy / cw + 1) * height / 2;
+    result[0] = Math.min(result[0], px); result[1] = Math.min(result[1], py);
+    result[2] = Math.max(result[2], px); result[3] = Math.max(result[3], py);
+  }
+  return result;
+}
