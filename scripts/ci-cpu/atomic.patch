+import { surfaceLayout } from '../../src/renderer/render-surface.js';
+import type { AtomicFrame } from './protocol.js';
+import type { PixelBuffer } from '../../src/core/pixels.js';
+export interface PresenterHost {
+ request(callback:FrameRequestCallback):number;cancel(id:number):void;
+ acknowledge(frame:AtomicFrame):void;presented(frame:AtomicFrame):void;failed(error:Error):void;
+}
+/** Owns every received bitmap until transferFromImageBitmap consumes it or close drops it. */
+export class AtomicPresenter {
+ private pending?:AtomicFrame;private scheduled=0;private disposed=false;private lastFrame=0;private revision=-1;
+ private context:ImageBitmapRenderingContext;
+ private current?:AtomicFrame;
+ readonly stats={received:0,presented:0,dropped:0,closed:0,maxPending:0,presentationMs:0};
+ constructor(private readonly canvas:HTMLCanvasElement,readonly generation:number,private readonly host:PresenterHost){
+  const context=canvas.getContext('bitmaprenderer');if(!context)throw new Error('Atomic bitmap presentation is unavailable.');this.context=context;
+ }
+ accept(frame:AtomicFrame):void{
+  this.stats.received++;
+  if(this.disposed||frame.generation!==this.generation||frame.frameId<=this.lastFrame||frame.revision<this.revision){this.drop(frame);return;}
+  const s=frame.surface;
+  if(![s.x,s.y,s.width,s.height,s.fullWidth,s.fullHeight].every(Number.isInteger)||s.x<0||s.y<0||s.width<1||s.height<1||s.x+s.width>s.fullWidth||s.y+s.height>s.fullHeight||frame.bitmap.width!==s.width||frame.bitmap.height!==s.height||!Number.isFinite(frame.cssWidth)||!Number.isFinite(frame.cssHeight)||frame.cssWidth<=0||frame.cssHeight<=0){this.drop(frame);this.host.failed(new Error('Invalid atomic surface metadata.'));return;}
+  if(this.pending){if(frame.frameId<=this.pending.frameId){this.drop(frame);return;}this.drop(this.pending);}
+  this.pending=frame;this.stats.maxPending=Math.max(this.stats.maxPending,1);
+  if(!this.scheduled)this.scheduled=this.host.request(this.present);
+ }
+ private drop(frame:AtomicFrame):void{frame.bitmap.close();this.stats.closed++;this.stats.dropped++;this.host.acknowledge(frame);}
+ private present=():void=>{
+  this.scheduled=0;const frame=this.pending;this.pending=undefined;if(!frame)return;
+  if(this.disposed){this.drop(frame);return;}
+  const start=performance.now();
+  try{
+   const layout=surfaceLayout(frame.surface,frame.cssWidth,frame.cssHeight);
+   // Both DOM geometry and bitmap change inside one animation-frame callback.
+   // The browser cannot paint an intermediate JS statement.
+   Object.assign(this.canvas.style,{position:'absolute',left:`${layout.left}px`,top:`${layout.top}px`,width:`${layout.width}px`,height:`${layout.height}px`});
+   if(this.canvas.width!==frame.surface.width)this.canvas.width=frame.surface.width;
+   if(this.canvas.height!==frame.surface.height)this.canvas.height=frame.surface.height;
+   this.context.transferFromImageBitmap(frame.bitmap);
+   this.current=frame;this.lastFrame=frame.frameId;this.revision=frame.revision;this.stats.presented++;this.stats.presentationMs+=performance.now()-start;
+   this.host.presented(frame);
+  }catch(error){frame.bitmap.close();this.stats.closed++;this.host.failed(error instanceof Error?error:new Error(String(error)));}
+  finally{this.host.acknowledge(frame);}
+ };
+ /** Reconstitute legacy full-frame bottom-up premultiplied capture from the displayed crop. */
+ capture():PixelBuffer{
+  const frame=this.current;if(!frame)throw new Error('No atomic frame has been presented.');
+  const {surface:s}=frame,output=this.canvas.ownerDocument.createElement('canvas');output.width=s.fullWidth;output.height=s.fullHeight;
+  const ctx=output.getContext('2d',{willReadFrequently:true});if(!ctx)throw new Error('Capture unavailable.');
+  ctx.drawImage(this.canvas,s.x,s.fullHeight-s.y-s.height,s.width,s.height);
+  const rgba=ctx.getImageData(0,0,s.fullWidth,s.fullHeight).data,pixels=new Uint8Array(rgba.length),stride=s.fullWidth*4;
+  for(let y=0;y<s.fullHeight;y++)pixels.set(rgba.subarray(y*stride,(y+1)*stride),(s.fullHeight-1-y)*stride);
+  for(let i=0;i<pixels.length;i+=4)if(pixels[i+3]!<255)for(let c=0;c<3;c++)pixels[i+c]=Math.round(pixels[i+c]!*pixels[i+3]!/255);
+  return{width:s.fullWidth,height:s.fullHeight,pixels};
+ }
