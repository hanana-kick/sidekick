+import type { RenderBridge,BridgeCallbacks } from '../../src/runtime/render-bridge.js';
+import type { RuntimeCommand,RuntimeEvent,RuntimeSnapshot,RuntimeState } from '../../src/runtime/protocol.js';
+import { AtomicPresenter } from './presenter.js';
+import type { AtomicFrame,AtomicRequest,AtomicResponse } from './protocol.js';
+import type { AtomicProducer } from './producer.js';
+export class AtomicSurfaceBridge implements RenderBridge {
+ readonly transferred=false;revision=0;
+ readonly backend:'worker'|'main';
+ private worker?:Worker;private producer?:AtomicProducer;private disposed=false;
+ private queued:AtomicRequest[]=[];private ready?:{snapshot:RuntimeSnapshot;revision:number};private readySent=false;
+ private frame=0;private events:{event:RuntimeEvent;revision:number}[]=[];private presenter:AtomicPresenter;
+ private timeout?:ReturnType<typeof setTimeout>;private surface?:AtomicFrame['surface'];
+ readonly metrics={bitmapMs:0,created:0,maxInFlight:0};
+ get presentationStats(){return{...this.presenter.stats,...this.metrics,surface:this.surface?{...this.surface}:undefined};}
+ constructor(canvas:HTMLCanvasElement,readonly generation:number,private readonly callbacks:BridgeCallbacks,worker:boolean){
+  this.backend=worker?'worker':'main';
+  this.presenter=new AtomicPresenter(canvas,generation,{request:cb=>requestAnimationFrame(cb),cancel:id=>cancelAnimationFrame(id),acknowledge:frame=>this.post({kind:'ack',generation:frame.generation,frameId:frame.frameId}),presented:frame=>this.presented(frame),failed:error=>this.fail(error)});
+ }
+ start(state:RuntimeState):void{
+  this.timeout=setTimeout(()=>this.fail(new Error('Atomic renderer startup timed out')),10000);
+  const init:AtomicRequest={kind:'init',generation:this.generation,state};
+  if(this.backend==='worker'){
+   this.worker=new Worker(new URL('./worker.js',import.meta.url),{type:'module'});
+   this.worker.addEventListener('message',this.message);this.worker.addEventListener('error',this.error);this.worker.addEventListener('messageerror',this.decodeError);
+   this.post(init);
+  }else{
+   this.queued.push(init);
+   void import('./producer.js').then(({AtomicProducer})=>{if(this.disposed)return;this.producer=new AtomicProducer(message=>this.receive(message));const queued=this.queued;this.queued=[];queued.forEach(message=>this.producer!.receive(message));}).catch(error=>this.fail(error instanceof Error?error:new Error(String(error))));
+  }
+ }
+ send(command:RuntimeCommand):void{if(!this.disposed)this.post({kind:'command',generation:this.generation,revision:++this.revision,command});}
+ private post(message:AtomicRequest):void{
+  if(this.disposed)return;
+  try{if(this.worker)this.worker.postMessage(message);else if(this.producer)this.producer.receive(message);else this.queued.push(message);}catch(error){this.fail(error instanceof Error?error:new Error(String(error)));}
+ }
+ private message=({data}:MessageEvent<AtomicResponse>):void=>this.receive(data);
+ private receive(data:AtomicResponse):void{
+  if(data.kind==='bitmap'){
+   if(this.disposed||data.generation!==this.generation){data.bitmap.close();return;}
+   this.metrics.bitmapMs+=data.metrics.bitmapMs;this.metrics.created=data.metrics.created;this.metrics.maxInFlight=data.metrics.maxInFlight;
+   this.presenter.accept(data);return;
+  }
+  if(this.disposed||data.generation!==this.generation)return;
+  if(data.kind==='failure'){this.fail(new Error(data.message),data.rendererFallback);return;}
+  if(data.kind==='ready'){this.ready={snapshot:data.snapshot,revision:data.revision};return;}
+  if(data.revision>this.revision)return;
+  const event=data.event;
+  // Observable frame state advances only with its atomically presented bitmap.
+  if(event.kind==='frame')return;
+  if(event.kind==='error'){this.callbacks.event(event,data.revision);return;}
+  if(event.kind==='complete'&&event.snapshot.frames>this.frame){this.events.push({event,revision:data.revision});return;}
+  this.callbacks.event(event,data.revision);
+ }
+ private presented(frame:AtomicFrame):void{
+  this.frame=frame.snapshot.frames;this.surface={...frame.surface};
+  if(!this.readySent&&this.ready){this.readySent=true;clearTimeout(this.timeout);this.timeout=undefined;this.callbacks.ready(frame.snapshot,frame.revision);}
+  this.callbacks.event({kind:'frame',snapshot:frame.snapshot},frame.revision);
+  const pending=this.events;this.events=[];
+  for(const item of pending){if('snapshot'in item.event&&item.event.snapshot.frames>this.frame)this.events.push(item);else this.callbacks.event(item.event,item.revision);}
+ }
+ capture(){return this.backend==='main'&&this.producer?this.producer.capture():this.presenter.capture();}
+ /** Explicit experiment-only transport injection; never claims actual GPU context loss. */
+ simulateWorkerFailureForTest():void{if(this.backend!=='worker'||this.disposed)throw new Error('An active atomic worker is required.');this.fail(new Error('Simulated atomic worker transport failure (QA only).'));}
+ private error=(event:ErrorEvent):void=>{event.preventDefault();this.fail(new Error(event.message||'Atomic worker failed.'));};
+ private decodeError=():void=>this.fail(new Error('Atomic worker message could not be decoded.'));
+ private fail(error:Error,fallback=false):void{if(this.disposed)return;this.dispose();this.callbacks.failed(error,fallback);}
+ dispose():void{
+  if(this.disposed)return;
+  // Mark disposed first: closing a pending bitmap must not request another source frame.
+  this.disposed=true;this.presenter.dispose();clearTimeout(this.timeout);this.timeout=undefined;
+  // Keep the message sink on the terminated worker to close any already-queued bitmap.
+  // The worker/listener cycle becomes collectible after those queued events drain.
+  this.worker?.removeEventListener('error',this.error);this.worker?.removeEventListener('messageerror',this.decodeError);this.worker?.terminate();this.worker=undefined;
+  this.producer?.dispose();this.producer=undefined;this.queued=[];this.events=[];
+ }
+}
