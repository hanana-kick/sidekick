--- /dev/null
+++ b/experiments/full-canvas-crop/tight-surface.ts
@@ -0,0 +1,58 @@
+import type { Mat4 } from '../../src/core/math.js';
+
+/** Integer backing-pixel crop; y is measured from the bottom, as in WebGL. */
+export interface RenderSurface { x: number; y: number; width: number; height: number; fullWidth: number; fullHeight: number }
+export type Bounds2 = [number, number, number, number];
+/** Grow-only within a resize epoch, avoiding per-frame allocation/size oscillation. */
+export function growSurface(previous: RenderSurface | undefined, bounds: Bounds2, fullWidth: number, fullHeight: number): RenderSurface {
+  // Two backing pixels protect coverage and derivative helper quads. Tile alignment
+  // adds slack and preserves the even-pixel 2x2 derivative-quad phase at the origin.
+  const tile = 16, guard = 2;
+  const low = (value: number, max: number): number => Math.min(Math.floor((max - 1) / tile) * tile, Math.max(0, Math.floor((value - guard) / tile) * tile));
+  const high = (value: number, max: number): number => Math.max(1, Math.min(max, Math.ceil((value + guard) / tile) * tile));
+  let x = low(bounds[0], fullWidth), y = low(bounds[1], fullHeight);
+  let right = high(bounds[2], fullWidth), top = high(bounds[3], fullHeight);
+  if (!bounds.every(Number.isFinite) || right <= x || top <= y) { x = y = 0; right = fullWidth; top = fullHeight; }
+  if (previous && previous.fullWidth === fullWidth && previous.fullHeight === fullHeight) {
+    x = Math.min(x, previous.x); y = Math.min(y, previous.y);
+    right = Math.max(right, previous.x + previous.width); top = Math.max(top, previous.y + previous.height);
+  }
+  return Object.freeze({ x, y, width: right - x, height: top - y, fullWidth, fullHeight });
+}
+/** Reconstitute the baseline bottom-up RGBA layout for correctness comparisons. */
+export function expandSurfacePixels(pixels: Uint8Array, surface: RenderSurface): Uint8Array {
+  const result = new Uint8Array(surface.fullWidth * surface.fullHeight * 4);
+  for (let row = 0; row < surface.height; row++) result.set(pixels.subarray(row * surface.width * 4, (row + 1) * surface.width * 4), ((surface.y + row) * surface.fullWidth + surface.x) * 4);
+  return result;
+}
+
+/** Crop placement in the original host's CSS coordinates, independent of DPR rounding. */
+export function surfaceLayout(surface: RenderSurface, cssWidth: number, cssHeight: number): { left: number; top: number; width: number; height: number } {
+  const sx = cssWidth / surface.fullWidth, sy = cssHeight / surface.fullHeight;
+  return { left: surface.x * sx, top: (surface.fullHeight - surface.y - surface.height) * sy, width: surface.width * sx, height: surface.height * sy };
+}
+
+/** Tight bounds of the actually submitted indexed triangles, including outgoing
+ * accessories. Keep matrix multiplication order identical to the shader. A
+ * near-plane crossing is not safe to crop from vertex extrema: retain full frame.
+ */
+export function projectedVertexBounds(vertices: Float32Array, indices: Uint16Array, indexOffset: number, count: number, model: Mat4, projection: Mat4, width: number, height: number): Bounds2 {
+  const result: Bounds2 = [Infinity, Infinity, -Infinity, -Infinity];
+  for (let i = indexOffset; i < indexOffset + count; i++) {
+    const index = indices[i]!;
+    const offset = index * 6, x = vertices[offset]!, y = vertices[offset + 1]!, z = vertices[offset + 2]!;
+    const wx = model[0]! * x + model[4]! * y + model[8]! * z + model[12]!;
+    const wy = model[1]! * x + model[5]! * y + model[9]! * z + model[13]!;
+    const wz = model[2]! * x + model[6]! * y + model[10]! * z + model[14]!;
+    const ww = model[3]! * x + model[7]! * y + model[11]! * z + model[15]!;
+    const cx = projection[0]! * wx + projection[4]! * wy + projection[8]! * wz + projection[12]! * ww;
+    const cy = projection[1]! * wx + projection[5]! * wy + projection[9]! * wz + projection[13]! * ww;
+    const cz = projection[2]! * wx + projection[6]! * wy + projection[10]! * wz + projection[14]! * ww;
+    const cw = projection[3]! * wx + projection[7]! * wy + projection[11]! * wz + projection[15]! * ww;
+    if ((!Number.isFinite(cx) || !Number.isFinite(cy) || !Number.isFinite(cz) || !Number.isFinite(cw)) || cw <= 0 || cz < -cw) return [0,0,width,height];
+    const px = (cx / cw + 1) * width / 2, py = (cy / cw + 1) * height / 2;
+    result[0] = Math.min(result[0], px); result[1] = Math.min(result[1], py);
+    result[2] = Math.max(result[2], px); result[3] = Math.max(result[3], py);
+  }
+  return result;
+}
