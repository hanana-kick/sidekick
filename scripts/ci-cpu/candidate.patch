+import { AvatarRenderer } from '../../src/renderer/webgl.js';
+import type { RenderState } from '../../src/renderer/webgl.js';
+import type { AvatarDesign } from '../../src/core/design.js';
+import type { Mat4 } from '../../src/core/math.js';
+import type { Geometry } from '../../src/renderer/geometry.js';
+import type { Mesh, RenderBackend, RendererOptions } from '../../src/renderer/render-backend.js';
+import { SoftwareRasterizer } from './software-rasterizer.js';
+import type { SoftwareEyes } from './software-rasterizer.js';
+import { growSurface, projectedVertexBounds, expandSurfacePixels } from './tight-surface.js';
+import type { Bounds2, RenderSurface } from './tight-surface.js';
+type Canvas = HTMLCanvasElement | OffscreenCanvas;
+type Damage = Readonly<{x:number;y:number;width:number;height:number}>;
+export interface StorageDiagnostics { readonly storage?:Readonly<RenderSurface>; readonly damage?:Damage; readonly full:Readonly<{width:number;height:number}>; readonly valid:boolean }
+const union=(a:Damage|undefined,b:Damage):Damage=>{
+ if(!a)return Object.freeze({...b});const x=Math.min(a.x,b.x),y=Math.min(a.y,b.y);
+ return Object.freeze({x,y,width:Math.max(a.x+a.width,b.x+b.width)-x,height:Math.max(a.y+a.height,b.y+b.height)-y});
+};
+
+/** Disabled Canvas-only storage experiment. Actual presentation backing and CSS
+ * remain full-sized; no image bitmap transport, physical crop, or WebGL change. */
+export class FullPresentationRenderer extends AvatarRenderer {
+ private storageBackend?:FullPresentationCanvasBackend;
+ constructor(canvas:Canvas,options:RendererOptions={}){
+  super(canvas,options);
+  if(this.graphics==='canvas2d'){
+   const backend=new FullPresentationCanvasBackend(canvas,this.backend.maxDimension);
+   this.backend.dispose();this.storageBackend=backend;this.backend=backend;
+  }
+ }
+ get diagnostics():StorageDiagnostics|undefined{return this.storageBackend?.diagnostics;}
+ override render(design:AvatarDesign,state:RenderState):void{
+  try{this.storageBackend?.assertAvailable();super.render(design,state);this.storageBackend?.assertAvailable();}catch(error){this.storageBackend?.abort();throw error;}
+ }
+}
+
+/** Shared logical meshes only. Deferred CPU work completes before canvas commit.
+ * Upload failure may leave canvas partially cleared: captures then reject until
+ * recovery. No atomic visible rollback claim is made for clearRect/putImageData.
+ */
+export class FullPresentationCanvasBackend implements RenderBackend {
+ readonly kind='canvas2d' as const;
+ get lost():boolean{
+  const lost=this.context.isContextLost?.()??false;
+  if(lost){this.valid=false;this.resetRequired=true;}
+  return lost;
+ }
+ private readonly context:CanvasRenderingContext2D|OffscreenCanvasRenderingContext2D;
+ private readonly raster=new SoftwareRasterizer();
+ private commands?:Array<()=>void>;
+ private projection!:Mat4;
+ private bounds:Bounds2=[Infinity,Infinity,-Infinity,-Infinity];
+ private indices=new WeakMap<Uint16Array,Map<string,Uint16Array>>();
+ private envelope?:RenderSurface;
+ private storage?:RenderSurface;
+ private previousDamage?:Damage;
+ private lastDamage?:Damage;
+ private fullWidth=0;private fullHeight=0;
+ private image?:ImageData;
+ private eyesState?:SoftwareEyes;
+ private alpha=1;private draws=0;
+ private valid=false;private disposed=false;private resetRequired=false;
+ constructor(readonly canvas:Canvas,readonly maxDimension=384){
+  const context=canvas.getContext('2d',{alpha:true}) as CanvasRenderingContext2D|OffscreenCanvasRenderingContext2D|null;
+  if(!context)throw new Error('Canvas storage context unavailable');this.context=context;
+ }
+ get diagnostics():StorageDiagnostics{return Object.freeze({storage:this.storage,damage:this.lastDamage,full:Object.freeze({width:this.canvas.width,height:this.canvas.height}),valid:!this.lost&&this.valid&&this.fullWidth===this.canvas.width&&this.fullHeight===this.canvas.height});}
+ assertAvailable():void{if(this.disposed)throw new Error('Backend disposed');if(this.lost)throw new Error('Canvas context lost');}
+ upload(data:Geometry):Mesh{return {data,count:data.indices.length};}
+ adopt(_mesh:Mesh):void{if(this.disposed)throw new Error('Backend disposed');}
+ update(_mesh:Mesh,_data:Geometry,_indices:boolean,_reuseVertices:boolean):void{if(_indices)this.indices.delete(_data.indices);}
+ deleteMesh(_mesh:Mesh):void{}
+ begin(projection:Mat4):void{
+  this.assertAvailable();
+  this.valid=false;this.projection=projection;this.commands=[];this.draws=0;this.alpha=1;this.eyesState=undefined;
+  this.bounds=[Infinity,Infinity,-Infinity,-Infinity];
+  if(this.resetRequired||this.fullWidth!==this.canvas.width||this.fullHeight!==this.canvas.height){
+   this.resetRequired=false;
+   this.fullWidth=this.canvas.width;this.fullHeight=this.canvas.height;this.envelope=undefined;this.storage=undefined;
+   // A resized canvas is clear, and a newly acquired canvas may contain old ink.
+   // Clear conservatively once per epoch without allocating a full CPU image.
+   this.previousDamage={x:0,y:0,width:this.fullWidth,height:this.fullHeight};
+  }
+ }
+ eyes(eyes?:SoftwareEyes):void{this.eyesState=eyes;}
+ opacity(value:number):void{this.alpha=value;}
+ draw(mesh:Mesh,model:Mat4,color:string,count:number,indexOffset:number):void{
+  if(!this.commands)throw new Error('Frame not begun');
+  if(count===0||this.alpha<=0)return;
+  const data=mesh.data,alpha=this.alpha,eyes=this.eyesState,projection=this.projection;
+  let ranges=this.indices.get(data.indices);if(!ranges){ranges=new Map();this.indices.set(data.indices,ranges);}
+  const key=`${indexOffset}:${count}`;let referenced=ranges.get(key);
+  if(!referenced){referenced=Uint16Array.from(new Set(data.indices.subarray(indexOffset,indexOffset+count)));ranges.set(key,referenced);}
+  const bounds=projectedVertexBounds(data.vertices,referenced,0,referenced.length,model,projection,this.fullWidth,this.fullHeight);
+  this.bounds=[Math.min(this.bounds[0],bounds[0]),Math.min(this.bounds[1],bounds[1]),Math.max(this.bounds[2],bounds[2]),Math.max(this.bounds[3],bounds[3])];
+  // Capture this draw's Geometry reference: another fading accessory may replace
+  // the shared logical mesh data before deferred replay.
+  this.commands.push(()=>this.raster.draw(data,model,projection,color,count,indexOffset,alpha,eyes));this.draws++;
+ }
+ end():void{
+  this.assertAvailable();
+  const commands=this.commands;this.commands=undefined;if(!commands)return;
+  const storage=this.draws?growSurface(this.envelope,this.bounds,this.fullWidth,this.fullHeight)
+   :Object.freeze({x:0,y:0,width:1,height:1,fullWidth:this.fullWidth,fullHeight:this.fullHeight});
+  if(this.draws)this.envelope=storage;
+  const top=this.fullHeight-storage.y-storage.height;
+  this.raster.clear(storage.width,storage.height,{x:storage.x,y:top,width:this.fullWidth,height:this.fullHeight});
+  for(const command of commands)command();
+  if(!this.image||this.image.width!==storage.width||this.image.height!==storage.height)this.image=this.context.createImageData(storage.width,storage.height);
+  this.image.data.set(this.raster.pixels);
+  const current=Object.freeze({x:storage.x,y:top,width:storage.width,height:storage.height});
+  const damage=union(this.previousDamage,current);this.previousDamage=damage;this.lastDamage=damage;
+  // putImageData is 1:1 backing-pixel placement, never drawImage or CSS scaling.
+  this.assertAvailable();
+  this.context.clearRect(damage.x,damage.y,damage.width,damage.height);
+  this.context.putImageData(this.image,storage.x,top);
+  this.assertAvailable();
+  this.previousDamage=current;this.storage=storage;this.valid=true;
+ }
+ abort():void{this.commands=undefined;this.valid=false;}
+ readPixels():Uint8Array{
+  this.assertAvailable();
+  if(!this.diagnostics.valid||!this.storage)throw new Error('No valid completed storage frame');
+  return expandSurfacePixels(this.raster.readPixels(),this.storage);
+ }
+ dispose():void{if(this.disposed)return;this.disposed=true;this.abort();this.image=undefined;this.raster.dispose();}
+ initializationError(cause:unknown):Error{return cause instanceof Error?cause:new Error(String(cause));}
+}
