{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./playground/*"
      ]
    },
    "types": [
      "vite/client",
      "react",
      "react-dom",
      "node"
    ]
  },
  "include": [
    "playground/**/*.ts",
    "playground/**/*.tsx",
    "vite.config.ts"
  ]
}
