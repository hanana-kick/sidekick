{
  "name": "@hanana-kick/sidekick",
  "version": "0.1.0",
  "description": "API-designed 3D companions rendered as transparent web components.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": { "node": ">=22" },
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" },
    "./core": { "types": "./dist/src/core/design.d.ts", "import": "./dist/src/core/design.js" }
  },
  "files": ["dist/src", "README.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && node scripts/serve.mjs --watch",
    "start": "node scripts/serve.mjs",
    "test": "npm run build && node --test tests/core.test.mjs",
    "test:browser": "npm run build && node --test --test-concurrency=1 tests/browser.test.mjs",
    "check": "npm run typecheck && npm test && npm run test:browser"
  },
  "devDependencies": { "playwright-core": "1.57.0", "typescript": "5.8.3" }
}
