{
  "name": "sidekick",
  "version": "0.1.0",
  "description": "A framework-agnostic web component library that renders a bot avatar anywhere on the screen.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./dist/react.js",
    "./dist/sidekick.bundle.js"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/sidekick.js",
  "module": "./dist/sidekick.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/sidekick.js",
      "default": "./dist/sidekick.js"
    },
    "./avatar": {
      "types": "./dist/avatar.d.ts",
      "import": "./dist/avatar.js",
      "default": "./dist/avatar.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js",
      "default": "./dist/elements.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config vite.playground.config.ts",
    "build": "vite build && vite build --config vite.iife.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "preview": "vite preview --config vite.playground.config.ts"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
